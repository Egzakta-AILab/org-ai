# =============================================================================
# Deny-by-default. This meta-repo (egzakta-org) versions ONLY the orchestration
# layer. Everything else — code-repo clones, secrets, scratch files — stays
# untracked. Nothing is committed unless it is explicitly allow-listed below.
#
# Why deny-by-default: the workspace root holds secrets (env files, SSH keys,
# VPN configs, DB dumps) next to the orchestration files. An allow-list makes it
# impossible to commit them by accident.
# =============================================================================

# Ignore everything at the root...
/*

# ...then re-include only the orchestration layer.
!/.gitignore
!/.gitattributes
!/.org-ignore
!/LICENSE
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/repos.yaml
!/platform/
!/org/
!/atlas/
!/docs/
!/scripts/
!/.claude/
!/.github/

# Local / personal state inside otherwise-tracked dirs.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Python / tooling noise inside org/ (and anywhere tracked).
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.DS_Store

# Skills component: third-party reference skills live in ~/.cache/egzakta-org/ and
# the per-tool destination dirs, not in the meta-repo. Only skills we author go under
# platform/skills/vendor/ — and even there, language deps and secrets stay out.
platform/skills/vendor/**/node_modules/
platform/skills/vendor/**/.env
platform/skills/vendor/**/.env.local
platform/skills/vendor/**/.git/

# Atlas (knowledge graph) — content is allow-listed by the root `!/atlas/`, but
# per-user vault state, autogenerated nodes, and the unported scripts dir stay
# out. The atlas is canonical here; OneDrive becomes the one-way mirror.
/atlas/.obsidian/
/atlas/items/
/atlas/scripts/
/atlas/**/.DS_Store
